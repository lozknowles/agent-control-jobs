{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lozknowles.github.io/agent-control-jobs/spec/agent-template.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "id", "version", "description", "intended_use", "role", "workflow", "inputs", "output", "requirements", "compatible_jobs", "limitations", "blocked_when", "provenance", "qualification_refs", "files", "content_digest"],
  "properties": {
    "spec_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "intended_use": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "workflow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output": {"type": "object", "additionalProperties": false, "required": ["format", "requirements"], "properties": {"format": {"type": "string", "minLength": 1}, "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["capabilities", "permissions", "tools", "context", "memory"], "properties": {
      "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "permissions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "scope"], "properties": {"kind": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}}},
      "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "context": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "memory": {"type": "object", "additionalProperties": false, "required": ["mode", "requirements"], "properties": {"mode": {"enum": ["none", "run-scoped", "external-reference"]}, "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
    }},
    "provider_adaptations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "provider", "version", "file", "content_digest"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
      "provider": {"type": "string", "minLength": 1},
      "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "file": {"type": "string", "pattern": "^[a-zA-Z0-9._/-]+$"},
      "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }}},
    "compatible_jobs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blocked_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "url", "license", "upstream_revision", "adapted_files"], "properties": {"source": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}, "license": {"type": "string"}, "upstream_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "adapted_files": {"type": "array", "items": {"type": "string"}}}},
    "qualification_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9._/-]+$"}},
    "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
